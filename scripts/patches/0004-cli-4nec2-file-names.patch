+const char* nec2d_title(const char* section)
+{
+	static const char* const T[][2] = {
+		{ "FREQUENCY",                   "                                 - - - - - - FREQUENCY - - - - - -" },
+		{ "STRUCTURE IMPEDANCE LOADING", "                               - - - STRUCTURE IMPEDANCE LOADING - - -" },
