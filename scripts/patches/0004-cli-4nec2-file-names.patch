index 0000000..6130e5f
--- /dev/null
+++ b/src/nec2d_names.cpp
@@ -0,0 +1,280 @@
+/*
+	nec2d_names.cpp - 4nec2 / nec2dxs compatibility for the nec2++ command
+	line: where the input and output names come from when no -i is given.
+	See nec2d_names.h for the rules.
+
+	Copyright (C) 2026  Steven Burns
+
+	This program is free software; you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation; either version 2 of the License, or
+	(at your option) any later version.
+
+	This program is distributed in the hope that it will be useful,
+	but WITHOUT ANY WARRANTY; without even the implied warranty of
+	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+	GNU General Public License for more details.
+*/
+#include "nec2d_names.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace {
+
+const char *const TMP_NAME = "nec2d.tmp";
+
+bool verbose()
+{
+	const char *v = getenv("NECPP_VERBOSE");
+	return v && *v && strcmp(v, "0") != 0;
+}
+
+bool is_sep(char c)
+{
+#ifdef _WIN32
+	return c == '\\' || c == '/';
+#else
+	return c == '/';
+#endif
+}
+
+bool is_absolute(const std::string &p)
+{
+#ifdef _WIN32
+	if (p.size() >= 2 && p[1] == ':') return true;     /* C:\x, C:x */
+	return !p.empty() && is_sep(p[0]);                  /* \x, \\server\x */
+#else
+	return !p.empty() && p[0] == '/';
+#endif
+}
+
+std::string join(const std::string &dir, const std::string &name)
+{
+	if (dir.empty() || is_absolute(name)) return name;
+	if (is_sep(dir[dir.size() - 1])) return dir + name;
+#ifdef _WIN32
+	return dir + "\\" + name;
+#else
+	return dir + "/" + name;
+#endif
+}
+
+bool file_exists(const std::string &p)
+{
+#ifdef _WIN32
+	DWORD a = GetFileAttributesA(p.c_str());
+	return a != INVALID_FILE_ATTRIBUTES && !(a & FILE_ATTRIBUTE_DIRECTORY);
+#else
+	struct stat st;
+	return stat(p.c_str(), &st) == 0 && !S_ISDIR(st.st_mode);
+#endif
+}
+
+/* The directory holding the running executable, without a trailing
+   separator ("" if it cannot be found). */
+std::string exe_dir()
+{
+	std::string path;
+#ifdef _WIN32
+	char buf[MAX_PATH * 4];
+	DWORD n = GetModuleFileNameA(NULL, buf, (DWORD)sizeof buf);
+	if (n > 0 && n < sizeof buf) path.assign(buf, n);
+#else
+	char buf[4096];
+	ssize_t n = readlink("/proc/self/exe", buf, sizeof buf - 1);
+	if (n > 0) path.assign(buf, (size_t)n);
+#endif
+	size_t k = path.size();
+	while (k > 0 && !is_sep(path[k - 1])) k--;
+	if (k == 0) return "";
+	return path.substr(0, k > 1 ? k - 1 : k);
+}
+
+std::string current_dir()
+{
+#ifdef _WIN32
+	char buf[MAX_PATH * 4];
+	DWORD n = GetCurrentDirectoryA((DWORD)sizeof buf, buf);
+	return (n > 0 && n < sizeof buf) ? std::string(buf, n) : std::string();
+#else
+	char buf[4096];
+	return getcwd(buf, sizeof buf) ? std::string(buf) : std::string();
+#endif
+}
+
+/* stdin is redirected: a file or a pipe, not a console / tty. A process
+   started with no usable stdin handle (a GUI parent) also counts; reading
+   it then gives no names and the next source is tried. */
+bool stdin_redirected()
+{
+#ifdef _WIN32
+	HANDLE h = GetStdHandle(STD_INPUT_HANDLE);
+	if (h == NULL || h == INVALID_HANDLE_VALUE) return false;
+	return GetFileType(h) != FILE_TYPE_CHAR;
+#else
+	return !isatty(0);
+#endif
+}
+
+/* Trim whitespace and CR/LF, then one pair of surrounding double quotes
+   (and whitespace inside them). */
+std::string clean(const std::string &s)
+{
+	const char *ws = " \t\r\n\f\v";
+	size_t a = s.find_first_not_of(ws);
+	if (a == std::string::npos) return "";
+	size_t b = s.find_last_not_of(ws);
+	std::string t = s.substr(a, b - a + 1);
+	if (t.size() >= 2 && t[0] == '"' && t[t.size() - 1] == '"') {
+		t = t.substr(1, t.size() - 2);
+		a = t.find_first_not_of(ws);
+		if (a == std::string::npos) return "";
+		b = t.find_last_not_of(ws);
+		t = t.substr(a, b - a + 1);
+	}
+	return t;
+}
+
+/* The first two non-blank lines of fp. A line may be any length. */
+bool two_names(FILE *fp, std::string &in, std::string &out)
+{
+	std::string got[2];
+	int have = 0;
+	std::string line;
+	int c;
+	bool any = false;
+	while (have < 2) {
+		line.clear();
+		any = false;
+		while ((c = fgetc(fp)) != EOF) {
+			any = true;
+			if (c == '\n') break;
+			line += (char)c;
+		}
+		if (!any) break; /* EOF */
+		std::string t = clean(line);
+		if (!t.empty()) got[have++] = t;
+		if (c == EOF) break;
+	}
+	if (have < 2) return false;
+	in = got[0];
+	out = got[1];
+	return true;
+}
+
+bool copy_out(const std::string &s, char *buf, size_t size, const char *what)
+{
+	if (s.size() + 1 > size) {
+		fprintf(stderr, "nec2++: the %s file name is too long (%u characters)\n", what, (unsigned)s.size());
+		return false;
+	}
+	memcpy(buf, s.c_str(), s.size() + 1);
+	return true;
+}
+
+} /* namespace */
+
+extern "C" int nec2d_names_possible(void)
+{
+	if (stdin_redirected()) return 1;
+	std::string d = exe_dir();
+	return (!d.empty() && file_exists(join(d, TMP_NAME))) ? 1 : 0;
+}
+
+extern "C" int nec2d_resolve_names(int argc, char **argv, int first_positional,
+	char *in_name, size_t in_size, char *out_name, size_t out_size)
+{
+	const bool say = verbose();
+	std::string in, out, source;
+	std::string tmp_path;
+	bool from_tmp = false;
+
+	if (first_positional < 1) first_positional = 1;
+	const int npos = argc - first_positional;
+
+	/* 1. exactly two positional arguments */
+	if (npos == 2) {
+		in = clean(argv[first_positional]);
+		out = clean(argv[first_positional + 1]);
+		if (!in.empty() && !out.empty())
+			source = "the command line";
+	} else if (npos > 0 && say) {
+		fprintf(stderr, "nec2++: %d positional argument(s), not 2: not taken as file names\n", npos);
+	}
+
+	/* 2. stdin, when redirected */
+	if (source.empty() && stdin_redirected()) {
+		if (two_names(stdin, in, out))
+			source = "stdin";
+		else if (say)
+			fprintf(stderr, "nec2++: stdin is redirected but holds no two names\n");
+	}
+
+	/* 3. nec2d.tmp beside the executable */
+	const std::string ed = exe_dir();
+	if (source.empty() && !ed.empty()) {
+		tmp_path = join(ed, TMP_NAME);
+		FILE *fp = fopen(tmp_path.c_str(), "rb");
+		if (fp) {
+			if (two_names(fp, in, out)) {
+				source = tmp_path;
+				from_tmp = true;
+			} else {
+				fprintf(stderr, "nec2++: %s does not hold two file names\n", tmp_path.c_str());
+				fclose(fp);
+				return -1;
+			}
+			fclose(fp);
+		}
+	}
+
+	if (source.empty()) return 0;
+
+	/* Resolve: against the current directory; for nec2d.tmp names whose
+	   input is not found there, against the executable's directory. */
+	std::string rin = in, rout = out, base = "the current directory";
+	if (!file_exists(rin) && from_tmp && !is_absolute(in)) {
+		const std::string alt = join(ed, in);
+		if (file_exists(alt)) {
+			rin = alt;
+			rout = join(ed, out);
+			base = "the executable's directory " + ed;
+		}
+	}
+
+	if (say) {
+		fprintf(stderr, "nec2++: file names from %s, relative to %s\n", source.c_str(), base.c_str());
+		fprintf(stderr, "nec2++:   input  %s\n", is_absolute(rin) ? rin.c_str() : join(current_dir(), rin).c_str());
+		fprintf(stderr, "nec2++:   output %s\n", is_absolute(rout) ? rout.c_str() : join(current_dir(), rout).c_str());
+	}
+
+	if (!file_exists(rin)) {
+		fprintf(stderr, "nec2++: input file not found: %s (name from %s", in.c_str(), source.c_str());
+		if (from_tmp && !is_absolute(in))
+			fprintf(stderr, "; looked in %s and in %s", current_dir().c_str(), ed.c_str());
+		else if (!is_absolute(in))
+			fprintf(stderr, "; looked in %s", current_dir().c_str());
+		fprintf(stderr, ")\n");
+		return -1;
+	}
+
+	if (!copy_out(rin, in_name, in_size, "input") || !copy_out(rout, out_name, out_size, "output"))
+		return -1;
+	return 1;
+}
diff --git a/src/nec2d_names.h b/src/nec2d_names.h
new file mode 100644
index 0000000..1d4708c
--- /dev/null
+++ b/src/nec2d_names.h
@@ -0,0 +1,64 @@
+/*
+	nec2d_names.h - 4nec2 / nec2dxs compatibility for the nec2++ command line.
+
+	Copyright (C) 2026  Steven Burns
+
+	This program is free software; you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation; either version 2 of the License, or
+	(at your option) any later version.
+
+	This program is distributed in the hope that it will be useful,
+	but WITHOUT ANY WARRANTY; without even the implied warranty of
+	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+	GNU General Public License for more details.
+
+	4nec2 runs a NEC-2 engine installed as nec2dxs500.exe ... nec2dxs11k.exe
+	and hands it the input and output file names without any -i / -o. When
+	nec2++ is started with no -i, these functions find the two names, in this
+	order of preference:
+
+	  1. exactly two positional arguments:   nec2++ in.nec out.out
+	  2. the first two non-blank lines of stdin, when stdin is redirected
+	     (not a console / tty);
+	  3. the first two non-blank lines of nec2d.tmp in the directory of the
+	     executable itself, which 4nec2 writes before each run (paths
+	     relative to that directory, e.g. ..\out\WHIP_ANT.inp).
+
+	A source that does not yield two names is passed over for the next one.
+	Each name is trimmed of surrounding whitespace and CR/LF, and of a pair
+	of surrounding double quotes. A relative input name is resolved against
+	the current directory; when the names came from nec2d.tmp and the input
+	is not found there, both names are resolved against the executable's
+	directory instead. NECPP_VERBOSE=1 reports the source and the resolved
+	names on stderr. Nothing is ever written to stdout.
+
+	The functions have C linkage so that the dispatch build (which compiles
+	nec2cpp.cpp inside an engine namespace, scripts/build_cli.py) and a plain
+	build both reach the single definition in nec2d_names.cpp.
+*/
+#ifndef NEC2D_NAMES_H
+#define NEC2D_NAMES_H
+
+#include <stddef.h>
+
+#define NEC2D_NAME_MAX 4096
+
+extern "C" {
+
+/* Non-zero when a no-argument run could take its names from stdin or
+   nec2d.tmp (stdin redirected, or nec2d.tmp beside the executable). Reads
+   nothing. */
+int nec2d_names_possible(void);
+
+/* Find the input and output names (see above). argv[first_positional..argc-1]
+   are the arguments left after option parsing. Returns 1 with the resolved
+   names in in_name / out_name, 0 when no source applies (the caller's normal
+   error path follows), or -1 after printing an error on stderr (the input
+   does not exist, or a name is too long). */
+int nec2d_resolve_names(int argc, char **argv, int first_positional,
+	char *in_name, size_t in_size, char *out_name, size_t out_size);
+
+}
+
+#endif /* NEC2D_NAMES_H */
